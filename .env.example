# ---------------------------------------------------------------------------
# Backend (backend/.env) — NEVER commit the real file, NEVER ship to frontend
# ---------------------------------------------------------------------------
# OpenAI key is used ONLY by the backend. Leave empty to keep the mock AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Port the backend API listens on.
PORT=8787

# Comma-separated list of origins allowed to call the backend.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------------------
# Base URL of the backend API. If empty, the frontend runs fully standalone
# with the in-browser MockConversationService (this is what GitHub Pages uses).
VITE_API_BASE_URL=
