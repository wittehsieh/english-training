# Backend environment. Copy to `backend/.env` (git-ignored) and fill in.
# The frontend NEVER sees these values.

# --- AI engine -------------------------------------------------------------
# Leave OPENAI_API_KEY empty  -> MockAIConversationService (rules, offline, free)
# Set it                      -> OpenAIConversationService (the real coworker)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout (ms) and SDK retry count for the OpenAI call.
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1

# --- server --------------------------------------------------------------
PORT=8787
# Comma-separated allowed browser origins. Use "*" only for local hacking.
CORS_ORIGIN=http://localhost:5173
