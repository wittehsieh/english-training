# Backend environment. Copy to `backend/.env` (git-ignored) and fill in.
# The frontend NEVER sees these values.

# Leave empty to use the built-in mock AI. Set it to enable OpenAI (Phase 2).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Port the API listens on.
PORT=8787

# Comma-separated allowed browser origins. Use "*" only for local hacking.
CORS_ORIGIN=http://localhost:5173
