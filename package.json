{
  "name": "workplace-english-adventure",
  "version": "0.1.0",
  "private": true,
  "description": "A 2D visual-novel-style workplace English learning game.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck --workspace backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
